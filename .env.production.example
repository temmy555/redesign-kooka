APP_ENV=production
APP_URL=https://kookaresidencesby.com

# Generate with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# PostgreSQL container credentials.
POSTGRES_USER=kooka
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=kooka

# App port exposed only to localhost on the server.
APP_PORT=3000
TZ=Asia/Jakarta
SITE_MAINTENANCE_MODE=off
# Required only for password-protected production preview during maintenance.
# Generate with: openssl rand -base64 32
MAINTENANCE_PREVIEW_SECRET=
MAINTENANCE_PREVIEW_DURATION_HOURS=8
# Optional: customize message on the Coming Soon page
SITE_MAINTENANCE_TITLE=Website Under Maintenance
SITE_MAINTENANCE_MESSAGE=Sorry, KOOKA Residence booking services and website are currently undergoing maintenance. We will be back online as soon as possible.
SITE_MAINTENANCE_EXPECTED=Return time: as scheduled

# Conservative pool for one 2GB Lightsail server.
DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000

# Redis intentionally disabled for first AWS deployment.
REDIS_URL=

# Private uploads / generated PDFs.
PRIVATE_STORAGE_ROOT=/app/.data/private-files

# Hostinger SMTP, production email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_FROM=KOOKA Residence Surabaya <reservation@kookaresidencesby.com>
SMTP_USER=reservation@kookaresidencesby.com
SMTP_PASSWORD=replace-with-hostinger-email-password

# Leave empty in production. Mailpit is local/UAT only.
MAILPIT_URL=

# Only set this temporarily when running production migrations.
ALLOW_PRODUCTION_MIGRATION=

# Only set this temporarily to create the first Owner login.
# Remove it again after bootstrap is done.
# Generate with:
# openssl rand -hex 32
OWNER_BOOTSTRAP_TOKEN=
