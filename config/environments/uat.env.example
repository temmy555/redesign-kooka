APP_ENV=uat
APP_URL=https://uat.kooka.example.invalid
BETTER_AUTH_SECRET=replace-via-uat-secret
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key-via-uat-secret
# OWNER_BOOTSTRAP_TOKEN=replace-temporarily-via-uat-secret-store
DATABASE_URL=postgresql://kooka_uat:replace-via-uat-secret@postgres-uat.internal:5432/kooka_uat
REDIS_URL=rediss://:replace-via-uat-secret@redis-uat.internal:6379
PRIVATE_STORAGE_ROOT=/srv/kooka-uat/private-files
SMTP_HOST=smtp-uat.internal
SMTP_PORT=587
SMTP_FROM=KOOKA UAT <no-reply@uat.kooka.example.invalid>
