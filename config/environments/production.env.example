APP_ENV=production
APP_URL=https://kookaresidencesby.com
SITE_MAINTENANCE_MODE=off
# MAINTENANCE_PREVIEW_SECRET=replace-with-password-at-least-8-characters
MAINTENANCE_PREVIEW_DURATION_HOURS=8
BETTER_AUTH_SECRET=replace-via-production-secret
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key-via-production-secret
# OWNER_BOOTSTRAP_TOKEN=replace-temporarily-via-production-secret-store
DATABASE_URL=postgresql://kooka_app:replace-via-production-secret@postgres.internal:5432/kooka
REDIS_URL=rediss://:replace-via-production-secret@redis.internal:6379
PRIVATE_STORAGE_ROOT=/srv/kooka/private-files
SMTP_HOST=smtp.production.internal
SMTP_PORT=587
SMTP_FROM=KOOKA Residence <no-reply@kookaresidencesby.com>
