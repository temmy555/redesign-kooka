APP_ENV=development
APP_URL=http://localhost:3000
SITE_MAINTENANCE_MODE=off
# Required only when maintenance mode is on and developers need to review the
# actual production website. Generate with: openssl rand -base64 32
MAINTENANCE_PREVIEW_SECRET=
MAINTENANCE_PREVIEW_DURATION_HOURS=8
# Optional: customize message on the Coming Soon page
SITE_MAINTENANCE_TITLE=Coming Soon
SITE_MAINTENANCE_MESSAGE=Website KOOKA Residence dalam pemeliharaan. Kami kembali sebentar lagi.
SITE_MAINTENANCE_EXPECTED=Segera
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Required before saving bank account or tax identity data.
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
# Uncomment only while creating the first Owner, then remove it.
# OWNER_BOOTSTRAP_TOKEN=generate-a-separate-random-value-at-least-32-characters
DATABASE_URL=postgresql://kooka:copy-from-env-infrastructure@127.0.0.1:55432/kooka
DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
# Optional for testing deployments. When omitted, worker polls PostgreSQL directly.
REDIS_URL=redis://:copy-from-env-infrastructure@127.0.0.1:56379
PRIVATE_STORAGE_ROOT=.data/private-files
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_FROM=KOOKA Local <no-reply@kooka.local>
# Required by most hosted SMTP services.
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=email-account-password
MAILPIT_URL=http://127.0.0.1:18025
